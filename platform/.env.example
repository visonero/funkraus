# Copy to .env.local and fill in real values. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-key>

# Server-only — NEVER expose these to the browser (no NEXT_PUBLIC_ prefix).

# Supabase → Settings → API Keys → "Publishable and secret API keys" tab → Secret keys.
# Bypasses Row Level Security — used by the Stripe webhook to write purchases.
SUPABASE_SERVICE_ROLE_KEY=<supabase-secret-key>

# Stripe → Developers → API keys (test mode / sandbox).
STRIPE_SECRET_KEY=<stripe-secret-key-test-mode>

# Stripe → the course product's one-time Price ID.
STRIPE_PRICE_ID=<stripe-price-id>

# Stripe CLI, for local webhook testing: run
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# it prints a fresh signing secret each time — paste it here. In production
# this instead comes from the webhook endpoint you register in the Stripe
# dashboard.
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# Local only: fills the dashboard with sample progress data (ignored in production builds).
# DEMO_DASHBOARD=1

# Optional override for the Google Analytics 4 measurement ID; the default lives in src/lib/consent.ts.
NEXT_PUBLIC_GA_ID=

# --- AI tower practice (prototype) ---
# Anthropic API key for the tower's answers. Without it the feature stays closed in production.
ANTHROPIC_API_KEY=
# Kill switch: set to 0 to stop every tower call immediately.
# TOWER_ENABLED=1
# Optional overrides (defaults in src/lib/tower/config.ts):
# TOWER_MODEL=claude-haiku-4-5-20251001
# TOWER_USER_MONTHLY_BUDGET_USD=2.5
# TOWER_GLOBAL_MONTHLY_BUDGET_USD=60
# TOWER_MAX_SESSIONS_PER_DAY=5
# TOWER_MAX_TURNS=16
# TOWER_FREE_TRIAL_SESSIONS=1
